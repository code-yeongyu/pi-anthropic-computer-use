{
	"name": "pi-anthropic-computer-use",
	"version": "0.1.1",
	"description": "Anthropic native computer use extension for the pi coding agent. Registers the computer tool executor and ensures computer_20250124 is injected on anthropic-messages payloads when opt-in is enabled.",
	"type": "module",
	"license": "MIT",
	"homepage": "https://github.com/code-yeongyu/pi-anthropic-computer-use",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/code-yeongyu/pi-anthropic-computer-use.git"
	},
	"bugs": {
		"url": "https://github.com/code-yeongyu/pi-anthropic-computer-use/issues"
	},
	"keywords": [
		"pi",
		"pi-mono",
		"pi-coding-agent",
		"pi-extension",
		"coding-agent",
		"anthropic",
		"computer-use",
		"screen-automation",
		"claude",
		"typescript"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"files": [
		"src",
		"README.md",
		"CHANGELOG.md",
		"LICENSE",
		"NOTICE"
	],
	"scripts": {
		"build": "npm run typecheck",
		"test": "vitest --run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"check": "tsc --noEmit && biome check ."
